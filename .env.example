# Google Tag Manager. Sin este valor el sitio no carga ningún script de terceros.
NEXT_PUBLIC_GTM_ID=

# La fotografía se sirve desde /public/media (los archivos ya están en el repo).
# Poné "false" solo si preferís consumirla desde el CDN.
NEXT_PUBLIC_MEDIA_LOCAL=true

# Proveedor de tracking de envíos. El número de operación se concatena al final.
# Si queda vacío, la consulta se deriva al equipo por WhatsApp.
NEXT_PUBLIC_TRACKING_URL=

# Webhook del CRM que recibe los leads del cotizador (server-side).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
